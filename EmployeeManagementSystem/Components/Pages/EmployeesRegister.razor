@page "/EmployeesRegister"
@rendermode InteractiveServer
@* @inject IUsersImportService UsersImportService *@
@inject ILogger<EmployeesRegister> Logger

<PageTitle>Import Users</PageTitle>

<div class="import-container">
    <h2>Registro de información. Datos Generales</h2>

    <div class="upload-section">
        <label class="form-label fw-semibold">Seleccione el archivo Excel: Registro_Datos_Generales (.xlsx / .xls)</label>
        @* Button to donwload the xlsx template (Registro_Datos_Generales) *@
        <div class="input-group">
            @* This button triggers the hidden file input *@
            <label class="btn btn-outline-secondary customButton1" for="fileInput">
                Abrir
            </label>
        
            @* This displays the filename or a custom message in Spanish *@
            <span class="form-control bg-light">
                @(_selectedFile?.Name ?? "Ningún archivo seleccionado")
            </span>

            @* The actual InputFile is hidden from view *@
            <InputFile id="fileInput"
                       OnChange="OnFileSelected"
                       class="d-none"
                       accept=".xlsx,.xls" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_fileInfo))
    {
        <div class="info-section mt-3">
            <label class="form-label fw-semibold">File Information</label>
            <textarea class="form-control font-monospace"
                      rows="6"
                      readonly>@_fileInfo</textarea>
        </div>
    }

    @if (_validationErrors.Count > 0)
    {
        <div class="alert alert-warning mt-3">
            <strong>Errores:</strong>
            <ul class="mb-0 mt-1" style="max-height: 150px; overflow-y: auto; list-style-position: inside;">
                @foreach (var error in _validationErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (_successMessage is not null)
    {
        <div class="alert alert-success mt-3">@_successMessage</div>
    }

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger mt-3">@_errorMessage</div>
    }

    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary customButton2"
                disabled="@(!_fileReady || _isProcessing)"
                @onclick="SubmitAsync">
            @if (_isProcessing)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                <span>Procesando…</span>
            }
            else
            {
                <span>Procesar</span>
            }
        </button>

        <button class="btn btn-outline-secondary"
                disabled="@_isProcessing"
                @onclick="Reset">
            Limpiar
        </button>
    </div>
</div>

<style>
    /* Hide the default browser text but keep the functionality */
    .custom-file-input::-webkit-file-upload-button {
        visibility: hidden;
        display: none;
    }

    .custom-file-input::before {
        content: 'Abrir'; /* Your custom text */
        display: inline-block;
        background: #f8f9fa;
        border: 1px solid #ced4da;
        border-radius: 4px;
        padding: 5px 12px;
        outline: none;
        white-space: nowrap;
        cursor: pointer;
        font-weight: 700;
        font-size: 10pt;
        margin-right: 10px;
    }

    .custom-file-input:hover::before {
        border-color: #adb5bd;
    }

    .customButton1 {
        background: #5b5fc7;
        color: white;
        font-size: 20px;
        font-weight: bold;
    }

    .customButton2 {
        background: #61a1fe;
        color: white;
        font-size: 20px;
        font-weight: bold;
    }

    .import-container {
        max-width: 680px;
        margin: 2rem auto;
        padding: 2rem;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: .5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.07);
    }

    .upload-section,
    .info-section {
        display: flex;
        flex-direction: column;
        gap: .4rem;
    }

    textarea.font-monospace {
        font-size: .85rem;
        background-color: #f8f9fa;
        color: #495057;
        resize: vertical;
    }
</style>