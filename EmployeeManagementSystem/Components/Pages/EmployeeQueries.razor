@page "/EmployeeQueries"
@using EmployeeManagementSystem.Components.Modals
@rendermode InteractiveServer
@inject ILogger<Register> Logger

<PageTitle>Consultas de empleados</PageTitle>

@if (!_isLoading)
{
    <div class="container">

        <div class="content">
            <div class="form-row">
                <div class="form-group">
                    <label>Número de empleado</label>
                    <input @bind="_employeeNumber" type="number" />
                </div>
                <div class="form-group">
                    <label>Nombre</label>
                    <input @bind="_name" type="text" />
                </div>
                <div class="form-group">
                    <label>Apellido</label>
                    <input @bind="_lastname" type="text" />
                </div>
                <div class="form-group">
                    <label>RFC</label>
                    <input @bind="_rfc" type="text" />
                </div>
                <div class="form-group">
                    <label>CUIP</label>
                    <input @bind="_cuip" type="text" />
                </div>
                <div>
                    <button @onclick="FilterEmployees" class="btn btn-primary customButton1">BUSCAR</button>
                </div>
            </div>

            <table>
                <colgroup>
                    <col style="width: 8%;"> <!-- Fixed width for first column -->
                    <col style="width: 15%;">  <!-- Percentage width for second column -->
                    <col style="width: 15%;">
                    <col style="width: 12%;">
                    <col style="width: 12%;">
                    <col style="width: 10%;">
                    <col style="width: 20%;">
                    <col>
                </colgroup>
                <thead class="tableHead">
                    <tr>
                        <th>Número de empleado</th>
                        <th>Nombre(s)</th>
                        <th>Apellidos</th>
                        <th>RFC</th>
                        <th>CUIP</th>
                        <th>Número de teléfono</th>
                        <th>Correo electrónico</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in _Employees)
                    {
                        <tr>
                            <td>@employee.Id</td>
                            <td>
                                <div style="overflow-x: auto; white-space: nowrap; max-width: 100%;">
                                    @employee.Name
                                </div>                                
                            </td>
                            <td>
                                <div style="overflow-x: auto; white-space: nowrap; max-width: 100%;">
                                    @employee.LastName
                                </div>
                            </td>
                            <td>@employee.Rfc</td>
                            <td>@employee.Cuip</td>
                            <td>@employee.PhoneNumber</td>
                            <td>
                                <div style="overflow-x: auto; white-space: nowrap; max-width: 100%;">
                                    @employee.Email
                                </div>
                            </td>
                            <td class="buttonTable">
                                <button @onclick="() => OpenModal(employee.Id)" class="btn btn-primary btn-sm fw-bold">
                                    Abrir
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>    
            </table>
        </div>


        <div class="pagination">
            <button class="page-btn"
                    @onclick="() => ChangePage(_currentPage - 1)"
                    disabled="@(_currentPage <= 1)">
                &#60;
            </button>

            @for (int i = 1; i <= _totalPages; i++)
            {
                int index = i;
                <button class="page-btn @(_currentPage == index ? "active" : "")"
                        @onclick="() => ChangePage(index)">
                    @index
                </button>
            }

            <button class="page-btn"
                    @onclick="() => ChangePage(_currentPage + 1)"
                    disabled="@(_currentPage >= _totalPages)">
                &#62;
            </button>
        </div>
    </div>
}
else
{
    <div class="spinner-wrapper">
        <div class="spinner"></div>
    </div>
}
<EmployeeInformationModal @ref="_modal" OnSave="HandleSave" />

<style>
    /* Keeps the pairs side-by-side */
    .form-row {
        display: flex;
        gap: 20px; /* Space between each pair */
        flex-wrap: wrap; /* Allows wrapping on small screens */
        align-items: flex-end; /* aligns all children to the bottom baseline */        
    }

    /* Keeps labels on top of their inputs */
    .form-group label {
        display: block;
        margin-bottom: 5px; /* Space between label and input */
        font-weight: bold;
    }

    /* Optional: Make inputs consistent */
    .form-group input {
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .customButton1 {
        background: #5b5fc7;
        color: white;
        font-size: 18px;
        font-weight: bold;
    }

    table {
        table-layout: fixed;
        width: 100%;
        margin: 20px auto;
        border-collapse: collapse;
        border: 1px solid #999999;
        border-bottom: 1px solid #999999;
    }

    .tableHead{
        font-size: 14px;
    }

    th{
        background-color: #2E427D;
        color: white;
    }

    th,td {
        padding: 0.5em;
        border: 1px solid #999999;
    }

    tbody tr:nth-child(odd) {
        background-color: #eeeeee;
    }

    caption {
        padding: 1em;
        font-style: italic;
        caption-side: bottom;
        letter-spacing: 1px;
    }

    .spinner-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 200px;
    }

    .spinner {
        width: 48px;
        height: 48px;
        border: 5px solid rgba(91, 95, 199, 0.2);
        border-top-color: #5b5fc7;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .container {
        display: flex;
        flex-direction: column;
        min-height: calc(100vh - 100px); /* adjust 60px to your navbar height */
    }

    .content {
        flex: 1; /* pushes pagination to the bottom */
    }

    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        padding: 16px 0;
        border-top: 1px solid #ddd;
    }

    .page-btn {
        min-width: 36px;
        height: 36px;
        border: 1px solid #2E427D;
        border-radius: 6px;
        background-color: white;
        color: #2E427D;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .page-btn:hover:not(:disabled) {
        background-color: #2E427D;
        color: white;
    }

    .page-btn.active {
        background-color: #2E427D;
        color: white;
    }

    .page-btn:disabled {
        border-color: #aaa;
        color: #aaa;
        cursor: not-allowed;
    }

    .buttonTable{
        text-align: center;
        vertical-align: middle;
    }
</style>