@if (_isVisible)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-container" @onclick:stopPropagation="true">

            @if (_isLoading)
            {
                <div class="loading-overlay">
                    <div class="spinner-large"></div>
                </div>
            }

            <div class="modal-header">
                <div class="modal-title-group">
                    <span class="modal-icon">👤</span>
                    <div>
                        <h2 class="modal-title">Evaluación de desempeño</h2>
                        <p class="modal-subtitle">ID #@_editPerformanceEvaluation.EmployeeNumber</p>
                    </div>
                </div>
                <button class="modal-close" @onclick="Close">✕</button>
            </div>

            <div class="modal-body">
                <div class="field-grid">

                    <div class="field-group full-width">
                        <label class="field-label">Número de Empleado</label>
                        <input class="field-input" type="number" min="1" step="1"
                               @bind="_editPerformanceEvaluation.EmployeeNumber" placeholder="Ej. 10042" />
                    </div>
                    <div class="field-group">
                        <label class="field-label">Nombre(s)</label>
                        <input class="field-input" type="text"
                               @bind="_editPerformanceEvaluation.Name" placeholder="Nombre" />
                    </div>
                    <div class="field-group">
                        <label class="field-label">Apellidos</label>
                        <input class="field-input" type="text"
                               @bind="_editPerformanceEvaluation.LastName" placeholder="Apellidos" />
                    </div>
                    <div class="field-group">
                        <label class="field-label">Puesto</label>
                        <input class="field-input" type="text" disabled
                               @bind="_editPerformanceEvaluation.LastPayrollPosition"/>

                    </div>
                    <div class="field-group">
                        <label class="field-label">RFC</label>
                        <input class="field-input" type="text"
                               @bind="_editPerformanceEvaluation.Rfc" />
                    </div>
                    <div class="field-group">
                        <label class="field-label">CURP</label>
                        <input class="field-input" type="text"
                               @bind="_editPerformanceEvaluation.Curp" />
                    </div>
                    <div class="field-group">
                        <label class="field-label">CUIP</label>
                        <input class="field-input" type="text"
                               @bind="_editPerformanceEvaluation.Cuip" />
                    </div>
                    @* ---------------------------------------- *@
                    <div class="field-group">
                        <label class="field-label">Calificación final</label>
                        <input class="field-input" type="number"
                               @bind="_editPerformanceEvaluation.FinalTestScore" />
                    </div>
                    <div class="field-group">
                        <label class="field-label">Nivel de desempeño</label>

                        <select @bind="_editPerformanceEvaluation.PerformanceLevelId">
                            <option value="">-- Seleccione --</option>
                            @foreach (var service in _PerformanceLevels)
                            {
                                if (_editPerformanceEvaluation.PerformanceLevelId != service.Key)
                                {
                                    <option value=@service.Key>@service.Value</option>
                                }
                                else
                                {
                                    <option value=@service.Key selected>@service.Value</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="field-group">
                        <label class="field-label">Fecha de acuse</label>
                        <input class="field-input" type="date"
                               @bind="_editPerformanceEvaluation.AcknowledgementDate" />
                    </div>
                    <div class="field-group">
                        <label class="field-label">Fecha de entrega de la unidad</label>
                        <input class="field-input" type="date"
                               @bind="_editPerformanceEvaluation.UnitDeliveryDate" />
                    </div>
                    <div class="field-group">
                        <label class="field-label">Oficio de entrega</label>
                        <input class="field-input" type="text"
                               @bind="_editPerformanceEvaluation.DeliveryLetter" />
                    </div>
                    <div></div>

                    <div class="field-group">
                        <label class="field-label">Observación o incidencia</label>
                        <textarea class="field-input" type="text"
                                  @bind="_editPerformanceEvaluation.Observations" />
                    </div>
                    <div class="field-group">
                        <label class="field-label">Plan individual de acción</label>
                        <input class="field-input" type="text"
                               @bind="_editPerformanceEvaluation.IndividualActionPlan" />
                    </div>                    
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn-cancel" @onclick="Close" disabled="@_isLoading">Cancelar</button>
                <button class="btn-save" @onclick="Save" disabled="@_isLoading"><span>Guardar Cambios</span></button>
                <button class="btn-download" @onclick="DownloadPdf" disabled="@_isLoading">Descargar</button>
            </div>
        </div>
    </div>
}

<style>
    /* ── Overlay ─────────────────────────────────────────── */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(10, 14, 26, 0.72);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        animation: overlayIn .18s ease;
    }

    @@keyframes overlayIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    /* ── Container ───────────────────────────────────────── */
    .modal-container {
        background: #ffffff;
        border-radius: 16px;
        width: min(1600px, 95vw);
        height: min(800px, 80vw);
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 6px rgba(0,0,0,.04), 0 20px 60px rgba(0,0,0,.18);
        animation: slideUp .22s cubic-bezier(.34,1.26,.64,1);
        overflow: hidden;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(28px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* ── Header ──────────────────────────────────────────── */
    .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 22px 28px 18px;
        border-bottom: 1px solid #f0f0f0;
        background: linear-gradient(135deg, #5e548e 0%, #8f80d9 100%);
    }

    .modal-title-group {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .modal-icon {
        font-size: 2rem;
        background: rgba(255,255,255,.15);
        border-radius: 10px;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .modal-title {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 700;
        color: #ffffff;
        letter-spacing: -.01em;
    }

    .modal-subtitle {
        margin: 2px 0 0;
        font-size: .8rem;
        color: rgba(255,255,255,.65);
    }

    .modal-close {
        background: rgba(255,255,255,.15);
        border: none;
        color: #fff;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .15s;
        flex-shrink: 0;
    }

        .modal-close:hover {
            background: rgba(255,255,255,.28);
        }

    /* ── Body ────────────────────────────────────────────── */
    .modal-body {
        padding: 24px 28px;
        overflow-y: auto;
        flex: 1 1 0;
        min-height: 0;
        /* Custom scrollbar */
        scrollbar-width: thin;
        scrollbar-color: #c5cfe8 transparent;
    }

    .modal-body::-webkit-scrollbar {
        width: 6px;
    }

    .modal-body::-webkit-scrollbar-track {
        background: transparent;
    }

    .modal-body::-webkit-scrollbar-thumb {
        background: #c5cfe8;
        border-radius: 99px;
    }

    .modal-body::-webkit-scrollbar-thumb:hover {
        background: #1e5799;
    }

    .field-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr); /* Cantidad de columnas */
        gap: 18px 20px;
    }

    .field-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .field-group.full-width {
            grid-column: 1 / -1;
        }

    .field-label {
        font-size: .75rem;
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .field-input {
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        padding: 9px 13px;
        font-size: .92rem;
        color: #111827;
        background: #f9fafb;
        transition: border-color .15s, box-shadow .15s, background .15s;
        outline: none;
        width: 100%;
        box-sizing: border-box;
    }

        .field-input:focus {
            border-color: #1e5799;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(30,87,153,.12);
        }

        .field-input:hover:not(:focus) {
            border-color: #9ca3af;
            background: #ffffff;
        }

    /* ── Footer ──────────────────────────────────────────── */
    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 16px 28px 22px;
        border-top: 1px solid #f0f0f0;
        flex-shrink: 0;
    }

    .btn-cancel {
        background: #660b03;
        border: 1.5px solid #d1d5db;
        color: #FFFFFF;
        padding: 9px 22px;
        border-radius: 8px;
        font-size: .9rem;
        font-weight: 500;
        cursor: pointer;
        transition: border-color .15s, background .15s;
    }

        .btn-cancel:hover {
            border-color: #9ca3af;
            background: #a31205;
            transform: translateY(-1px);
        }

    .btn-save {
        background: linear-gradient(135deg, #1a3a6b 0%, #1e5799 100%);
        border: none;
        color: #ffffff;
        padding: 9px 26px;
        border-radius: 8px;
        font-size: .9rem;
        font-weight: 600;
        cursor: pointer;
        letter-spacing: .01em;
        transition: opacity .15s, transform .12s;
        box-shadow: 0 2px 8px rgba(30,87,153,.35);
    }

        .btn-save:hover {
            opacity: .9;
            transform: translateY(-1px);
        }

        .btn-save:active {
            opacity: 1;
            transform: translateY(0);
        }

    .btn-download {
        background: #0a7344;
        border: 1.5px solid #d1d5db;
        color: #FFFFFF;
        padding: 9px 22px;
        border-radius: 8px;
        font-size: .9rem;
        font-weight: 500;
        cursor: pointer;
        transition: border-color .15s, background .15s;
    }

        .btn-download:hover {
            border-color: #9ca3af;
            background: #0d9e5d;
            transform: translateY(-1px);
        }

    @@media (max-width: 900px) {
        .field-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .field-grid {
            grid-template-columns: 1fr;
        }

        .modal-body {
            padding: 18px;
        }

        .modal-header, .modal-footer {
            padding-left: 18px;
            padding-right: 18px;
        }
    }

    /* Container for centering the spinner */
    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(255, 255, 255, 0.6); /* Semi-transparent white */
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10; /* Ensure it stays above modal content */
        border-radius: 8px; /* Match your modal-container border-radius */
    }

    /* Larger version of your spinner for the center focus */
    .spinner-large {
        width: 40px;
        height: 40px;
        border: 4px solid rgba(0, 0, 0, 0.1);
        border-top-color: #2d5af7; /* Use your theme color here */
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* Ensure the modal container is the reference point */
    .modal-container {
        position: relative;
        /* ... existing styles ... */
    }
</style>