@* NavMenu.razor *@
@rendermode InteractiveServer
<nav class="navbar-container">
    <div class="navbar-brand">
        @* Add your Socialight logo here *@
        <NavLink href="" Match="NavLinkMatch.All">
            @* <img src="images/logo.png" alt="SOCIALIGHT" class="logo-img" /> *@
        </NavLink>
    </div>

    <div class="navbar-links">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">INICIO</NavLink>

        <div class="nav-dropdown">
            <span class="nav-link nav-link-toggle" @onclick="() => ToggleSubMenu(OpenSubmenu.Employees)">
                PERSONAL
            </span>
            @if (openSubmenu == OpenSubmenu.Employees)
            {
                <div class="dropdown-menu-panel">
                    <NavLink class="dropdown-item" href="EmployeesRegister" @onclick="CloseSubMenu">
                        <span class="bi bi-plus-square-fill"></span>Registrar
                    </NavLink>
                    <NavLink class="dropdown-item" href="EmployeeQueries" @onclick="CloseSubMenu">
                        <span class="bi bi-plus-square-fill"></span>Consultar
                    </NavLink>
                </div>
            }
        </div>

        <div class="nav-dropdown">
            <span class="nav-link nav-link-toggle" @onclick="() => ToggleSubMenu(OpenSubmenu.PayrollRecord)">
                DATOS LABORALES
            </span>
            @if (openSubmenu == OpenSubmenu.PayrollRecord)
            {
                <div class="dropdown-menu-panel">
                    <NavLink class="dropdown-item" href="PayrollRecordRegister" @onclick="CloseSubMenu">
                        <span class="bi bi-plus-square-fill"></span>Registrar
                    </NavLink>
                    @* <NavLink class="dropdown-item" href="EmployeeQueries" @onclick="CloseSubMenu">
                        <span class="bi bi-plus-square-fill"></span>Consultar
                    </NavLink> *@
                </div>
            }
        </div>

        <div class="nav-dropdown">
            <span class="nav-link nav-link-toggle" @onclick="() => ToggleSubMenu(OpenSubmenu.TrustControl)">
                CONTROL DE CONFIANZA
            </span>
            @if (openSubmenu == OpenSubmenu.TrustControl)
            {
                <div class="dropdown-menu-panel">
                    <NavLink class="dropdown-item" href="TrustControlRegister" @onclick="CloseSubMenu">
                        <span class="bi bi-plus-square-fill"></span>Registro
                    </NavLink>
                    <NavLink class="dropdown-item" href="TrustControlQueries" @onclick="CloseSubMenu">
                        <span class="bi bi-plus-square-fill"></span>Consultas
                    </NavLink>
                </div>
            }
        </div>

        @* <NavLink class="nav-link" href="reports">REPORTES</NavLink>
        <NavLink class="nav-link" href="career">TRAYECTORIA</NavLink> *@
    </div>
</nav>

@if (openSubmenu != OpenSubmenu.None)
{
    <div class="click-outside-overlay" @onclick="CloseSubMenu"></div>
}

@code{

    private enum OpenSubmenu
    {
        None,
        Employees,
        PayrollRecord,
        TrustControl
    }

    private OpenSubmenu openSubmenu = OpenSubmenu.None;

    private void ToggleSubMenu(OpenSubmenu submenu)
    {
        openSubmenu = openSubmenu == submenu ? OpenSubmenu.None : submenu;
    }

    private void CloseSubMenu()
    {
        openSubmenu = OpenSubmenu.None;
    }
}

<style>
    .navbar-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: 0 10%;
        min-height: 80px;
        background-color: #5b5fc7;
        box-sizing: border-box;
    }

    .navbar-links {
        display: flex;
        align-items: center;
        gap: 30px;
        list-style: none;
        margin: 0;
        padding: 0;
        font-weight: bold;
    }

    .nav-link {
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        text-transform: uppercase;
        font-size: 0.9rem;
        transition: color 0.3s;
        white-space: nowrap;
    }

        .nav-link:hover, .nav-link.active {
            color: white;
            font-weight: bold;
        }

    /* Dropdown wrapper — the key fix */
    .nav-dropdown {
        position: relative; /* anchor for the absolute panel */
    }

    .nav-link-toggle {
        cursor: pointer;
        user-select: none;
    }

    /* Independent floating panel — does NOT affect the flex row */
    .dropdown-menu-panel {
        position: absolute;
        top: calc(100% + 12px);  /*just below the navbar */
        left: 0;
        background-color: #5b5fc7;
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 10px 0;
        min-width: 160px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        border-radius: 4px;
        z-index: 1000;
    }

    .dropdown-item {
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        text-transform: uppercase;
        font-size: 0.85rem;
        padding: 8px 1px;
        transition: background-color 0.2s, color 0.2s;
        white-space: nowrap;
    }

    .dropdown-item:hover {
        background-color: rgba(255, 255, 255, 0.15);
        color: white;
    }

    .logo-img {
        height: 40px;
    }

    .click-outside-overlay {
        position: fixed;
        inset: 0; /* covers the entire viewport */
        z-index: 999; /* below dropdown-menu-panel (1000) but above everything else */
    }
</style>